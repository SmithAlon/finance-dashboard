---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import KpiCard from "../components/KpiCard.astro";
import Tabs from "../components/Tabs.astro";
import TabPanel from "../components/TabPanel.astro";
import FlowForm from "../components/FlowForm.astro";
import AllocationSplit from "../components/AllocationSplit.astro";
import BalanceSheet from "../components/BalanceSheet.astro";
import DebtSummary from "../components/DebtSummary.astro";
import ActionPlan from "../components/ActionPlan.astro";
import {
  inflows,
  incomeCategories,
  outflows,
  expenseCategories,
  accounts,
  debt,
  framework,
  goals,
  actionPlan,
} from "../data/finance";
import type { Amounted } from "../data/types";
import type { Allocation } from "../types";
import { mxn, pct } from "../lib/format";

const sum = (xs: Amounted[]) => xs.reduce((a, x) => a + x.amount, 0);
const income = sum(inflows);
const spend = sum(outflows);
const surplus = income - spend;
const savingsRate = surplus / income;
const netWorth = sum(accounts) - debt;

// 50/30/20 targets (on income) vs. actual plan
const target: Allocation = {
  obligations: income * framework.obligations,
  savings: income * framework.savings,
  investing: income * framework.investing,
};
const savShare = framework.savings / (framework.savings + framework.investing);
const plan: Allocation = {
  obligations: spend,
  savings: surplus * savShare,
  investing: surplus * (1 - savShare),
};

const guaranteeDeposit =
  accounts.find((a) => a.name.startsWith("Credit"))?.amount ?? 0;
---

<Base title="Finance Dashboard">
  <main class="max-w-[1040px] mx-auto px-4 pt-8 pb-16 grid gap-4">
    <Header asOf={goals.today} />

    <section
      class="grid grid-cols-2 md:grid-cols-4 gap-3"
      role="tablist"
      aria-label="Finance sections"
    >
      <KpiCard
        label="Monthly inflow"
        value={mxn(income)}
        direction="in"
        tab="inflows"
        selected
      />
      <KpiCard
        label="Monthly outflow"
        value={mxn(spend)}
        note={`${pct(spend / income)} of inflow`}
        direction="out"
        tab="outflows"
      />
      <KpiCard
        label="Investable surplus"
        value={mxn(surplus)}
        note={`${pct(savingsRate)} savings rate`}
        featured
        tab="surplus"
      />
      <KpiCard
        label="Liquid net worth"
        value={mxn(netWorth)}
        note={`Debt: ${mxn(debt)}`}
        status={debt === 0 ? "healthy" : "alert"}
        tab="accounts"
      />
    </section>

    <Tabs />

    <TabPanel id="inflows">
      <FlowForm
        id="inflows"
        title="Income sources"
        noun="income"
        placeholder="Income source"
        totalLabel="Total monthly income"
        tone="inflow"
        categories={incomeCategories}
        items={inflows}
        legacyKey="finance:inflows:v1"
      />
    </TabPanel>

    <TabPanel id="outflows" hidden>
      <FlowForm
        id="outflows"
        title="Expenses"
        noun="expense"
        placeholder="Expense"
        totalLabel="Total monthly spending"
        tone="outflow"
        categories={expenseCategories}
        items={outflows}
      />
    </TabPanel>

    <TabPanel id="surplus" hidden>
      <AllocationSplit
        income={income}
        spend={spend}
        target={target}
        plan={plan}
      />
    </TabPanel>

    <TabPanel id="accounts" hidden class="grid gap-4">
      <BalanceSheet accounts={accounts} netWorth={netWorth} />
      <DebtSummary
        debt={debt}
        income={income}
        netWorth={netWorth}
        guaranteeDeposit={guaranteeDeposit}
        actions={actionPlan.filter((a) => a.title.includes("Nu card"))}
      />
    </TabPanel>
  </main>
</Base>
