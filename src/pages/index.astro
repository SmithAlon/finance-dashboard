---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import KpiCard from "../components/KpiCard.astro";
import Tabs from "../components/Tabs.astro";
import TabPanel from "../components/TabPanel.astro";
import FlowList from "../components/FlowList.astro";
import IncomeForm from "../components/IncomeForm.astro";
import AllocationSplit from "../components/AllocationSplit.astro";
import BalanceSheet from "../components/BalanceSheet.astro";
import DebtSummary from "../components/DebtSummary.astro";
import ActionPlan from "../components/ActionPlan.astro";
import {
  inflows,
  incomeCategories,
  outflows,
  accounts,
  debt,
  framework,
  goals,
  actionPlan,
} from "../data/finance";
import type { Amounted } from "../data/types";
import type { Allocation, Tab } from "../types";
import { mxn, pct } from "../lib/format";

const sum = (xs: Amounted[]) => xs.reduce((a, x) => a + x.amount, 0);
const income = sum(inflows);
const spend = sum(outflows);
const surplus = income - spend;
const savingsRate = surplus / income;
const netWorth = sum(accounts) - debt;

// 50/30/20 targets (on income) vs. actual plan
const target: Allocation = {
  obligations: income * framework.obligations,
  savings: income * framework.savings,
  investing: income * framework.investing,
};
const savShare = framework.savings / (framework.savings + framework.investing);
const plan: Allocation = {
  obligations: spend,
  savings: surplus * savShare,
  investing: surplus * (1 - savShare),
};

const maxFlow = Math.max(
  ...inflows.map((i) => i.amount),
  ...outflows.map((o) => o.amount),
);
const guaranteeDeposit =
  accounts.find((a) => a.name.startsWith("Credit"))?.amount ?? 0;
const tabs: Tab[] = [
  { id: "inflows", label: "Inflows" },
  { id: "outflows", label: "Outflows" },
  { id: "accounts", label: "Accounts" },
  { id: "debt", label: "Debt" },
];
---

<Base title="Finance Dashboard">
  <main class="max-w-[1040px] mx-auto px-4 pt-8 pb-16 grid gap-4">
    <Header asOf={goals.today} />

    <section class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <KpiCard label="Monthly inflow" value={mxn(income)} direction="in" />
      <KpiCard label="Monthly outflow" value={mxn(spend)} note={`${pct(spend / income)} of inflow`} direction="out" />
      <KpiCard
        label="Investable surplus"
        value={mxn(surplus)}
        note={`${pct(savingsRate)} savings rate`}
        featured
      />
      <KpiCard
        label="Liquid net worth"
        value={mxn(netWorth)}
        note={`Debt: ${mxn(debt)}`}
        status={debt === 0 ? "healthy" : "alert"}
      />
    </section>

    <Tabs tabs={tabs} />

    <TabPanel id="inflows">
      <IncomeForm categories={incomeCategories} items={inflows} />
    </TabPanel>

    <TabPanel id="outflows" hidden class="grid grid-cols-1 md:grid-cols-[1fr_1.3fr] gap-4">
      <FlowList
        title="Outflows"
        subtitle={`${mxn(spend)} per month, ${pct(spend / income)} of income.`}
        items={outflows}
        maxFlow={maxFlow}
        barClass="bg-outflow"
      />
      <AllocationSplit income={income} spend={spend} target={target} plan={plan} />
    </TabPanel>

    <TabPanel id="accounts" hidden>
      <BalanceSheet accounts={accounts} netWorth={netWorth} />
    </TabPanel>

    <TabPanel id="debt" hidden>
      <DebtSummary
        debt={debt}
        income={income}
        netWorth={netWorth}
        guaranteeDeposit={guaranteeDeposit}
        actions={actionPlan.filter((a) => a.title.includes("Nu card"))}
      />
    </TabPanel>

    <ActionPlan items={actionPlan} />
  </main>
</Base>
