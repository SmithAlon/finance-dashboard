---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Headline from "../components/Headline.astro";
import Tabs from "../components/Tabs.astro";
import TabPanel from "../components/TabPanel.astro";
import FlowForm from "../components/FlowForm.astro";
import CreditAccounts from "../components/CreditAccounts.astro";
import AccountsForm from "../components/AccountsForm.astro";
import FirstRun from "../components/FirstRun.astro";
import DataFooter from "../components/DataFooter.astro";
import DebtSummary from "../components/DebtSummary.astro";
import DebtCalculator from "../components/DebtCalculator.astro";
import BalanceView from "../components/BalanceView.astro";
import ActionPlan from "../components/ActionPlan.astro";
import Investments from "../components/Investments.astro";
import {
  inflows,
  incomeCategories,
  outflows,
  expenseCategories,
  accounts,
  credit,
  investments,
  gbmPortfolioCsv,
  gbmPortfolioFile,
  goals,
  actionPlan,
} from "../data/finance";
import { blank } from "../data/blank";
import { parseGbmCsv } from "../lib/gbm";
import { summarizeAccounts } from "../lib/accounts";
import prices from "../data/prices.json";
import type { PriceFeed } from "../data/types";

// The server renders the blank first-visit state; finance.ts is only the demo, passed to each
// editor as `demo` and loaded in the browser when the visitor asks for it.
const feed = prices as PriceFeed;
const demoInvestments = { ...investments, portfolio: parseGbmCsv(gbmPortfolioCsv, gbmPortfolioFile) };
---

<Base title="Finance Dashboard">
  <main class="max-w-[1040px] mx-auto px-4 pt-8 pb-16 grid gap-4">
    <Header asOf={goals.today} />
    <FirstRun />

    <Headline
      income={0}
      spend={0}
      seedAccounts={blank.accounts}
      seedCredit={blank.credit}
      seedInvestments={blank.investments}
      usdMxn={feed.usdMxn?.rate ?? null}
      fxDate={feed.usdMxn?.date ?? null}
      inflows="inflows"
      outflows="outflows"
      accounts="accounts"
      credit="credit"
      investments="investments"
    />

    <Tabs />

    <TabPanel id="balance">
      <BalanceView income={0} spend={0} inflows="inflows" outflows="outflows">
        <FlowForm
          slot="inflows"
          id="inflows"
          title="Income sources"
          noun="income"
          placeholder="Income source"
          totalLabel="Total monthly income"
          tone="inflow"
          categories={incomeCategories}
          items={blank.inflows}
          demo={inflows}
          legacyKey="finance:inflows:v1"
        />
        <FlowForm
          slot="outflows"
          id="outflows"
          title="Expenses"
          noun="expense"
          placeholder="Expense"
          totalLabel="Total monthly spending"
          tone="outflow"
          categories={expenseCategories}
          items={blank.outflows}
          demo={outflows}
        />
      </BalanceView>
    </TabPanel>

    <TabPanel id="debt" hidden class="grid gap-4">
      <CreditAccounts id="credit" seed={blank.credit} demo={credit} legacyKey="finance:credits:v2" />
      <DebtCalculator
        balance={blank.startingCash}
        demoBalance={summarizeAccounts(accounts).total}
        inflows="inflows"
        outflows="outflows"
        credit="credit"
        expenseCategories={expenseCategories}
      />
    </TabPanel>

    <TabPanel id="accounts" hidden class="grid gap-4">
      <AccountsForm id="accounts" seed={blank.accounts} demo={accounts} />
      <DebtSummary
        credit="credit"
        inflows="inflows"
        accounts="accounts"
        actions={actionPlan.filter((a) => a.title.includes("card utilization"))}
      />
    </TabPanel>

    <TabPanel id="investments" hidden class="grid gap-4 min-w-0">
      <Investments id="investments" seed={blank.investments} demo={demoInvestments} prices={feed} />
    </TabPanel>

    <DataFooter />
  </main>
</Base>
