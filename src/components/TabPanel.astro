---
import type { BalanceTabId, CreditTabId, InvestTabId, TabId } from '../types';

interface Props {
  id: TabId | BalanceTabId | CreditTabId | InvestTabId;
  hidden?: boolean;
  class?: string;
}
const { id, hidden = false, class: className } = Astro.props;
---
<section id={`panel-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} hidden={hidden} class={className}>
  <slot />
</section>
