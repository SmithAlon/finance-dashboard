---
import type { ActionItem } from '../data/types';
import ActionList from './ActionList.astro';

interface Props {
  /** `data-flow-id`s of the credit editor, the incomes form and the accounts editor, read live. */
  credit: string;
  inflows: string;
  accounts: string;
  actions: ActionItem[];
}
const { credit, inflows, accounts, actions } = Astro.props;

const stats = [
  { id: 'owed', label: 'Owed on credit', value: '$0' },
  { id: 'dti', label: 'Owed ÷ monthly income', value: '0.0%' },
  { id: 'deposit', label: 'Credit guarantee deposit', value: '$0' },
];
---
<div class="card" data-debt-summary data-credit={credit} data-in={inflows} data-accounts={accounts}>
  <h2 class="text-xl mb-2">Debt</h2>
  <p class="sub" data-text aria-live="polite">No credit accounts added yet.</p>
  <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-3">
    {
      stats.map((s) => (
        <div class="grid gap-0.5">
          <span class="label">{s.label}</span>
          <b class="mono text-xl" data-stat={s.id}>{s.value}</b>
        </div>
      ))
    }
  </div>
  <h3 class="text-xs uppercase tracking-[0.08em] text-ink-2 font-semibold mt-4 mb-1.5">Habits that keep debt low</h3>
  <ActionList items={actions} />
</div>

<script>
  import { dash, fmt, pct } from '../lib/format';
  import { toMonthly } from '../lib/income';
  import { readAccounts, readCredit, readFlow } from '../lib/flows';
  import { guaranteeDeposit, summarizeAccounts } from '../lib/accounts';
  import { owedText, summarize } from '../lib/credit';

  document.querySelectorAll<HTMLElement>('[data-debt-summary]').forEach((root) => {
    const q = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const render = () => {
      const accounts = readAccounts(root.dataset.accounts!);
      const assets = summarizeAccounts(accounts).total;
      const deposit = guaranteeDeposit(accounts);
      q('[data-stat=deposit]').textContent = deposit == null ? dash() : fmt(deposit);
      const s = summarize(readCredit(root.dataset.credit!));
      const income = readFlow(root.dataset.in!).reduce((a, l) => a + toMonthly(l.amount ?? 0, l.freq), 0);
      const n = s.views.length;
      q('[data-stat=owed]').textContent = s.complete ? fmt(s.owedKnown) : dash();
      q('[data-stat=dti]').textContent = s.complete && income ? pct(s.owedKnown / income) : '—';
      q('[data-text]').textContent = !n
        ? 'No credit accounts added yet, so none are counted here.'
        : !s.complete
          ? `${owedText(s)} so far. Liquid net worth can't be worked out until every balance is entered.`
          : s.owedKnown === 0
            ? 'Nothing owed on any account. Liquid net worth is everything you hold.'
            : assets == null
              ? `${owedText(s)}. Enter every account balance to see what is left once it is paid.`
              : `What you owe brings what your accounts hold from ${fmt(assets)} down to ${fmt(assets - s.owedKnown)}.`;
    };
    document.addEventListener('flowchange', render);
    render();
  });
</script>
