---
import TabPanel from "./TabPanel.astro";
import { mxn, pct } from "../lib/format";
import { tones } from "../lib/tone";

interface Props {
  /** Server totals (monthly) from finance.ts; the script swaps in the live form totals. */
  income: number;
  spend: number;
  /** `data-flow-id`s of the two FlowForms passed in the `inflows` and `outflows` slots. */
  inflows: string;
  outflows: string;
}
const { income, spend, inflows, outflows } = Astro.props;
const balance = income - spend;
const scale = Math.max(income, spend) || 1;

const sides = [
  { id: "inflows", label: "Incomes", value: income, bar: "bg-inflow", badge: "bg-inflow/12 text-inflow", arrow: "M11.5 4.5 4.5 11.5M4.5 6v5.5H10" },
  { id: "outflows", label: "Expenses", value: spend, bar: "bg-outflow", badge: "bg-outflow/12 text-outflow", arrow: "M4.5 11.5 11.5 4.5M6 4.5h5.5V10" },
] as const;
---

<div
  class="grid gap-4"
  data-balance-view
  data-in={inflows}
  data-out={outflows}
  data-hero-pos={tones.inflow.hero}
  data-hero-neg={tones.outflow.hero}
>
  <section
    class:list={["card", balance < 0 ? tones.outflow.hero : tones.inflow.hero]}
    aria-labelledby="balance-total"
    data-hero
  >
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
      <div class="grid gap-0.5">
        <span id="balance-total" class="label">Monthly balance · incomes − expenses</span>
        <b class="mono text-[40px] leading-tight" data-balance aria-live="polite">{mxn(balance)}</b>
      </div>
      <span class="text-ink-2 text-[13px]">
        <b class="mono text-ink" data-annual>{mxn(balance * 12)}</b> per year ·{" "}
        <b class="mono text-ink" data-rate>{pct(income ? balance / income : 0)}</b> kept
      </span>
    </div>

    <ul class="grid gap-3 mt-5">
      {
        sides.map((s) => (
          <li class="grid gap-1.5">
            <span class="flex items-center justify-between gap-3 text-[13px]">
              <span class="flex items-center gap-2">
                <span class:list={["grid place-items-center size-5 rounded-md", s.badge]} aria-hidden="true">
                  <svg viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d={s.arrow} />
                  </svg>
                </span>
                {s.label}
              </span>
              <b class="mono" data-side-total={s.id}>{mxn(s.value)}</b>
            </span>
            <span class="block h-2.5 rounded-full bg-surface-2 overflow-hidden">
              <i class:list={["block h-full rounded-full", s.bar]} data-side-bar={s.id} style={`width:${(s.value / scale) * 100}%`} />
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <div
    role="tablist"
    aria-label="Balance tables"
    class="inline-flex w-fit gap-1 p-1 bg-surface border border-line rounded-xl"
  >
    {
      sides.map((s, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${s.id}`}
          aria-controls={`panel-${s.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-tab={s.id}
          class="flex items-center rounded-lg px-3.5 py-1.5 text-[13px] font-medium text-ink-2 hover:text-ink transition-colors cursor-pointer aria-selected:bg-surface-2 aria-selected:text-ink aria-selected:ring-1 aria-selected:ring-line"
        >
          <span class:list={["dot", s.bar]} aria-hidden="true" />
          {s.label}
        </button>
      ))
    }
  </div>

  <TabPanel id="inflows"><slot name="inflows" /></TabPanel>
  <TabPanel id="outflows" hidden><slot name="outflows" /></TabPanel>
</div>

<script>
  import { mxn, pct } from "../lib/format";
  import { toAnnual, toMonthly } from "../lib/income";
  import { readFlow } from "../lib/flows";

  const init = (root: HTMLElement) => {
    const q = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const hero = q("[data-hero]");
    const pos = root.dataset.heroPos!.split(" ");
    const neg = root.dataset.heroNeg!.split(" ");
    const total = (id: string) => readFlow(id).reduce((a, l) => a + toMonthly(l.amount ?? 0, l.freq), 0);
    const annual = (id: string) => readFlow(id).reduce((a, l) => a + toAnnual(l.amount ?? 0, l.freq), 0);

    const render = () => {
      const income = total(root.dataset.in!);
      const spend = total(root.dataset.out!);
      const balance = income - spend;
      const scale = Math.max(income, spend) || 1;
      q("[data-balance]").textContent = (balance < 0 ? "−" : "") + mxn(Math.abs(balance));
      const year = annual(root.dataset.in!) - annual(root.dataset.out!);
      q("[data-annual]").textContent = (year < 0 ? "−" : "") + mxn(Math.abs(year));
      q("[data-rate]").textContent = pct(income ? balance / income : 0);
      for (const [id, v] of [["inflows", income], ["outflows", spend]] as const) {
        q(`[data-side-total="${id}"]`).textContent = mxn(v);
        q(`[data-side-bar="${id}"]`).style.width = (v / scale) * 100 + "%";
      }
      hero.classList.remove(...(balance < 0 ? pos : neg));
      hero.classList.add(...(balance < 0 ? neg : pos));
    };

    document.addEventListener("flowchange", render);
    render();
  };

  document.querySelectorAll<HTMLElement>("[data-balance-view]").forEach(init);
</script>
