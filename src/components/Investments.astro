---
// The Investments tab: the GBM portfolio (imported from the app's CSV export), fixed income and
// PPRs, reported the way GBM shows a portfolio (value today, cost, unrealised gain, allocation).
// Publishes its live store on `data-state` and fires `flowchange`, like the credit editor, so
// others can `readInvestments(id)`.
import InvestmentRow from "./InvestmentRow.astro";
import TabPanel from "./TabPanel.astro";
import type { InvestmentStore, PriceFeed } from "../data/types";
import type { InvestTabId } from "../types";
import { bucketLabels, type BucketId, type ManualBucketId } from "../lib/investments";
import { sliceFills, tones } from "../lib/tone";

interface Props {
  /** `data-flow-id` and localStorage prefix. */
  id: string;
  /** What a first visit starts with (nothing invested). */
  seed: InvestmentStore;
  /** The demo store, sample GBM portfolio included, loaded instead in demo mode. */
  demo: InvestmentStore;
  /** Build-time USD→MXN rate for a dollar portfolio. */
  prices: PriceFeed;
}
const { id, seed, demo, prices } = Astro.props;
const buckets: { id: BucketId; tab: InvestTabId; noun: string; hint: string }[] = [
  {
    id: "portfolio", tab: "invest-portfolio", noun: "position",
    hint: "In the GBM app, open your portfolio, download its detail as CSV and import the file here. Figures are GBM's, in the account's currency; the total above converts them to pesos.",
  },
  { id: "fixedIncome", tab: "invest-fixedIncome", noun: "instrument", hint: "CETES, government bonds, debt funds and term deposits. Enter the value with interest included." },
  { id: "ppr", tab: "invest-ppr", noun: "plan", hint: "Personal retirement plans. Locked until 65, and contributions can be deducted on your tax return within SAT limits." },
];
const manual = buckets.filter((b): b is typeof b & { id: ManualBucketId } => b.id !== "portfolio");
const addBtn =
  "inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-[13px] font-medium text-brand hover:text-brand-hover hover:bg-brand/10 transition-colors cursor-pointer";
// Circumference 100, so a slice's share in percent is its dash length.
const R = 15.9155;
---

<div
  class="grid gap-4 min-w-0"
  data-investment-editor
  data-flow-id={id}
  data-key={`finance:${id}:v4`}
  data-old-keys={JSON.stringify([`finance:${id}:v3`, `finance:${id}:v2`])}
  data-seed={JSON.stringify(seed)}
  data-demo={JSON.stringify(demo)}
  data-usd-mxn={prices.usdMxn?.rate ?? ""}
  data-fx-date={prices.usdMxn?.date ?? ""}
  data-fills={JSON.stringify(sliceFills)}
  data-gain-badges={JSON.stringify({ up: tones.inflow.badge, down: tones.outflow.badge, flat: tones.neutral.badge })}
  data-gain-text={JSON.stringify({ up: tones.inflow.text, down: tones.outflow.text, flat: tones.neutral.text })}
>
  <section class:list={["card", tones.passive.hero]} aria-labelledby={`${id}-total`}>
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
      <div class="grid gap-0.5">
        <span id={`${id}-total`} class="label">Invested · value today</span>
        <b class="mono text-[40px] leading-tight" data-total aria-live="polite">$0</b>
      </div>
    </div>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
      <p class="text-ink-2 text-[13px]" data-total-note>Nothing added yet</p>
      <button data-reset type="button" class={addBtn}>Reset</button>
    </div>

    <p class="mt-5 mb-3 text-[13px]" data-chart-takeaway aria-live="polite">Import your GBM portfolio to see what you are invested in.</p>
    <div class="grid sm:grid-cols-[176px_1fr] gap-x-8 gap-y-4 items-center">
      <div class="relative size-44 mx-auto">
        <svg viewBox="0 0 42 42" class="size-full -rotate-90" data-donut role="img" aria-label="Split of invested value; the list beside it gives each amount">
          <circle cx="21" cy="21" r={R} fill="none" stroke-width="5" class="stroke-surface-2" data-donut-track />
          <g data-segs></g>
        </svg>
        <div class="absolute inset-0 grid place-content-center text-center pointer-events-none" aria-hidden="true">
          <b class="mono text-[17px] leading-tight" data-center-value>$0</b>
          <span class="text-ink-2 text-[11px] max-w-24 truncate" data-center-label>invested</span>
        </div>
      </div>
      <ul class="grid gap-1 min-w-0 max-w-md" aria-label="Allocation" data-legend></ul>
    </div>
    <template data-template="slice">
      <li data-slice tabindex="0" class="flex items-center justify-between gap-3 text-[13px] rounded-md px-1.5 -mx-1.5 py-1 hover:bg-surface-2/60 focus-visible:bg-surface-2/60 transition-colors">
        <span class="flex items-center min-w-0">
          <i data-slice-dot class="dot"></i>
          <span data-slice-label class="truncate"></span>
        </span>
        <span class="text-ink-2 shrink-0">
          <b class="mono text-ink" data-slice-value></b> · <span data-slice-share></span>
        </span>
      </li>
    </template>
  </section>

  <section class="card min-w-0" aria-labelledby={`${id}-title`}>
    <h2 id={`${id}-title`} class="text-2xl mb-1.5">Your investments</h2>
    <p class="sub">
      Leave a value blank if you don't know it: it shows as missing, never as $0.
    </p>

    <div
      role="tablist"
      aria-label="Investment types"
      class="inline-flex flex-wrap w-fit gap-1 p-1 mb-4 bg-surface border border-line rounded-xl"
    >
      {
        buckets.map((b, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${b.tab}`}
            aria-controls={`panel-${b.tab}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-tab={b.tab}
            class="flex items-center rounded-lg px-3.5 py-1.5 text-[13px] font-medium text-ink-2 hover:text-ink transition-colors cursor-pointer aria-selected:bg-surface-2 aria-selected:text-ink aria-selected:ring-1 aria-selected:ring-line"
          >
            {bucketLabels[b.id]}
          </button>
        ))
      }
    </div>

    <TabPanel id="invest-portfolio">
      <p class="sub">{buckets[0].hint}</p>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-3">
        <label class:list={[addBtn, "-ml-2.5 focus-within:outline-2 focus-within:outline-brand"]}>
          ↑ Import
          <input data-import type="file" accept=".csv,text/csv" class="sr-only" />
        </label>
        <span class="text-ink-3 text-[12px]" data-portfolio-note></span>
      </div>
      <p data-import-error hidden role="alert" class="text-outflow text-[13px] mb-3"></p>
      <p data-empty="portfolio" class="text-ink-2 text-[13px] py-2">No portfolio imported yet.</p>
      <div class="overflow-x-auto" data-portfolio hidden>
        <table class="data-table">
          <thead>
            <tr>
              <th>Asset</th>
              <th class="text-right! hidden! sm:table-cell!">Shares</th>
              <th class="text-right! hidden! sm:table-cell!">Avg cost</th>
              <th class="text-right! hidden! sm:table-cell!">Price</th>
              <th class="text-right!">Value</th>
              <th class="text-right!">Gain</th>
              <th class="text-right! hidden! sm:table-cell!">Share</th>
            </tr>
          </thead>
          <tbody data-positions></tbody>
          <tfoot>
            <tr class="[&_td]:font-semibold [&_td]:border-b-0">
              <td>Total</td>
              <td class="hidden sm:table-cell" colspan="3"></td>
              <td class="mono text-right" data-pos-total></td>
              <td class="mono text-right" data-pos-total-gain></td>
              <td class="mono text-right hidden sm:table-cell">100%</td>
            </tr>
          </tfoot>
        </table>
      </div>
      <template data-template="position">
        <tr>
          <td><span class="flex items-center"><i data-pos-dot class="dot"></i><b data-pos-ticker class="mono"></b></span></td>
          <td class="mono text-right hidden sm:table-cell" data-pos-shares></td>
          <td class="mono text-right hidden sm:table-cell" data-pos-avg></td>
          <td class="mono text-right hidden sm:table-cell" data-pos-price></td>
          <td class="mono text-right" data-pos-value></td>
          <td class="mono text-right whitespace-nowrap" data-pos-gain></td>
          <td class="mono text-right hidden sm:table-cell" data-pos-share></td>
        </tr>
      </template>
    </TabPanel>

    {
      manual.map((b) => (
        <TabPanel id={b.tab} hidden>
          <p class="sub">{b.hint}</p>
          <ul data-list={b.id} class="grid gap-3" />
          <p data-empty={b.id} class="text-ink-2 text-[13px] py-2">
            No {b.noun}s yet.
          </p>
          <button data-add={b.id} type="button" class:list={[addBtn, "mt-3 -ml-2.5"]}>
            + Add {b.noun}
          </button>
          <template data-template={b.id}>
            <InvestmentRow bucket={b.id} />
          </template>
        </TabPanel>
      ))
    }
  </section>
</div>

<script>
  import type { InvestmentStore, Maybe, Portfolio, PprPlan } from "../data/types";
  import { parseGbmCsv } from "../lib/gbm";
  import {
    allocationTakeaway, blanks, gainText, investedNote, migratePpr, portfolioNote, summarizeInvestments, type ManualBucketId, type Slice, type SliceFill,
  } from "../lib/investments";
  import { money, mxn, pct, shareCount } from "../lib/format";
  import { confirmReset, seedOf } from "../lib/mode";

  const MANUAL: ManualBucketId[] = ["fixedIncome", "ppr"];
  const TEXT = new Set(["name", "kind", "frequency"]);
  const SVG = "http://www.w3.org/2000/svg";
  /** Surface gap between slices, in ring units (circumference 100): about 2px at this size. */
  const GAP = 0.6;

  const init = (root: HTMLElement) => {
    const KEY = root.dataset.key!;
    const seed = seedOf<InvestmentStore>(root);
    const usdMxn: Maybe = root.dataset.usdMxn ? Number(root.dataset.usdMxn) : null;
    const fxDate = root.dataset.fxDate;
    const fills: Record<SliceFill, { dot: string; stroke: string }> = JSON.parse(root.dataset.fills!);
    const badges: Record<"up" | "down" | "flat", string> = JSON.parse(root.dataset.gainBadges!);
    const gainTextCls: Record<"up" | "down" | "flat", string> = JSON.parse(root.dataset.gainText!);
    const q = <T extends Element = HTMLElement>(sel: string, el: ParentNode = root) => el.querySelector<T>(sel)!;
    const list = (b: ManualBucketId) => q(`[data-list="${b}"]`);
    const clone = <T extends Element>(name: string) =>
      q<HTMLTemplateElement>(`[data-template="${name}"]`).content.firstElementChild!.cloneNode(true) as T;
    const direction = (n: number, eps = 0.005) => (n > eps ? "up" : n < -eps ? "down" : "flat");
    let portfolio: Portfolio | null = seed.portfolio;

    const parse = (name: string, raw: string): unknown => {
      if (TEXT.has(name)) return raw;
      if (name === "maturity") return raw || null;
      return raw === "" ? null : Math.max(0, Number(raw) || 0);
    };
    const fields = (row: ParentNode) => [...row.querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-f]")];

    const addRow = (b: ManualBucketId, item = blanks[b]()) => {
      const row = clone<HTMLElement>(b);
      row.dataset.id = item.id;
      const values = item as unknown as Record<string, unknown>;
      fields(row).forEach((el) => {
        const v = values[el.dataset.f!];
        if (v !== undefined) el.value = v == null ? "" : String(v);
      });
      list(b).append(row);
      return row;
    };

    const readStore = (): InvestmentStore => ({
      portfolio,
      ...(Object.fromEntries(
        MANUAL.map((b) => [
          b,
          [...list(b).querySelectorAll<HTMLElement>("[data-row]")].map((row) => ({
            ...blanks[b](row.dataset.id),
            ...Object.fromEntries(fields(row).map((el) => [el.dataset.f!, parse(el.dataset.f!, el.value)])),
          })),
        ]),
      ) as Pick<InvestmentStore, ManualBucketId>),
    });

    const fill = (store: InvestmentStore) => {
      portfolio = store.portfolio;
      MANUAL.forEach((b) => {
        list(b).replaceChildren();
        (store[b] ?? []).forEach((item) => addRow(b, b === "ppr" ? migratePpr(item as PprPlan) : item));
      });
    };

    // Donut: one stroked circle per slice; hovering a slice or its legend row names it in the centre.
    let slices: Slice[] = [];
    let total = 0;
    const centre = (s?: Slice) => {
      q("[data-center-value]").textContent = s ? pct(s.value / total) : mxn(total);
      q("[data-center-label]").textContent = s ? s.label : "invested";
      root.querySelectorAll<SVGElement>("[data-seg]").forEach((el) => el.classList.toggle("opacity-30", !!s && el.dataset.seg !== s.id));
    };
    const drawDonut = () => {
      let start = 0;
      const gap = slices.length > 1 ? GAP : 0;
      q("[data-segs]").replaceChildren(
        ...slices.map((s) => {
          const len = (s.value / total) * 100;
          const c = document.createElementNS(SVG, "circle");
          Object.entries({ cx: "21", cy: "21", r: "15.9155", fill: "none", "stroke-width": "5" }).forEach(([k, v]) => c.setAttribute(k, v));
          c.setAttribute("stroke-dasharray", `${Math.max(len - gap, 0.01)} ${100 - Math.max(len - gap, 0.01)}`);
          c.setAttribute("stroke-dashoffset", String(-start - gap / 2));
          c.setAttribute("class", `${fills[s.fill].stroke} transition-opacity cursor-default`);
          c.dataset.seg = s.id;
          const title = document.createElementNS(SVG, "title");
          title.textContent = `${s.label}: ${mxn(s.value)} (${pct(s.value / total)})`;
          c.append(title);
          start += len;
          return c;
        }),
      );
      const track = q("[data-donut-track]");
      if (total > 0) track.removeAttribute("stroke-dasharray");
      else track.setAttribute("stroke-dasharray", "1 1");
      q("[data-legend]").replaceChildren(
        ...slices.map((s) => {
          const li = clone<HTMLElement>("slice");
          li.dataset.slice = s.id;
          q("[data-slice-dot]", li).className = `dot ${fills[s.fill].dot}`;
          q("[data-slice-label]", li).textContent = s.label;
          q("[data-slice-value]", li).textContent = mxn(s.value);
          q("[data-slice-share]", li).textContent = pct(s.value / total);
          return li;
        }),
      );
      centre();
    };
    const sliceOf = (el: EventTarget | null) => {
      const id = (el as Element | null)?.closest?.<HTMLElement | SVGElement>("[data-seg],[data-slice]");
      const key = id && ((id as HTMLElement).dataset.seg ?? (id as HTMLElement).dataset.slice);
      return slices.find((s) => s.id === key);
    };
    for (const type of ["mouseover", "focusin"]) root.addEventListener(type, (e) => {
      if ((e.target as Element).closest?.("[data-donut],[data-legend]")) centre(sliceOf(e.target));
    });
    for (const type of ["mouseout", "focusout"]) root.addEventListener(type, (e) => {
      if ((e.target as Element).closest?.("[data-donut],[data-legend]")) centre();
    });

    /** The imported positions as GBM lists them, in the account's currency. */
    const drawPortfolio = () => {
      q("[data-empty=portfolio]").hidden = !!portfolio;
      q("[data-portfolio]").hidden = !portfolio;
      q("[data-portfolio-note]").textContent = portfolio
        ? portfolioNote(portfolio, { usdMxn: usdMxn == null ? null : { rate: usdMxn, date: fxDate! } })
        : "";
      if (!portfolio) return;
      const cur = portfolio.currency;
      const show = (n: Maybe) => (n == null ? "—" : money(n, cur));
      const sum = portfolio.positions.reduce((s, p) => s + (p.value ?? 0), 0);
      const owned = portfolio.positions.filter((p) => p.value != null && p.cost != null);
      const gainSum = owned.reduce((s, p) => s + p.value! - p.cost!, 0);
      const costSum = owned.reduce((s, p) => s + p.cost!, 0);
      const signed = (gain: number, cost: number) =>
        `${gain > 0 ? "+" : ""}${money(gain, cur)}` + (cost ? ` (${gain > 0 ? "+" : gain < 0 ? "−" : ""}${pct(Math.abs(gain / cost))})` : "");
      q("[data-positions]").replaceChildren(
        ...portfolio.positions.map((p) => {
          const tr = clone<HTMLTableRowElement>("position");
          const slice = slices.find((s) => s.id === (p.cash ? "cash" : `p:${p.ticker}`)) ?? slices.find((s) => s.id === "other");
          q("[data-pos-dot]", tr).className = slice ? `dot ${fills[slice.fill].dot}` : "dot";
          q("[data-pos-ticker]", tr).textContent = p.ticker;
          q("[data-pos-shares]", tr).textContent = p.shares == null ? "—" : shareCount(p.shares);
          q("[data-pos-avg]", tr).textContent = show(p.avgCost);
          q("[data-pos-price]", tr).textContent = show(p.price);
          q("[data-pos-value]", tr).textContent = show(p.value);
          const gain = q("[data-pos-gain]", tr);
          if (p.value != null && p.cost != null) {
            gain.textContent = signed(p.value - p.cost, p.cost);
            gain.classList.add(gainTextCls[direction(p.value - p.cost)]);
          } else gain.textContent = "—";
          q("[data-pos-share]", tr).textContent = p.value == null || !sum ? "—" : pct(p.value / sum);
          return tr;
        }),
      );
      q("[data-pos-total]").textContent = money(sum, cur);
      const tg = q("[data-pos-total-gain]");
      tg.textContent = owned.length ? signed(gainSum, costSum) : "—";
      tg.className = `mono text-right whitespace-nowrap ${owned.length ? gainTextCls[direction(gainSum)] : ""}`;
    };

    const recalc = () => {
      const store = readStore();
      const s = summarizeInvestments(store, usdMxn);
      slices = s.slices;
      total = s.value;
      q("[data-total]").textContent = s.unknown && !s.value ? "$—" : mxn(s.value);
      q("[data-total-note]").textContent = investedNote(s);
      q("[data-chart-takeaway]").textContent = allocationTakeaway(s);
      drawDonut();
      drawPortfolio();
      for (const b of s.buckets) {
        if (b.id === "portfolio") continue;
        q(`[data-empty="${b.id}"]`).hidden = b.rows.length > 0;
        const rows = [...list(b.id).querySelectorAll<HTMLElement>("[data-row]")];
        b.rows.forEach((v, i) => {
          q("[data-out-value]", rows[i]).textContent = v.value == null ? "$—" : mxn(v.value);
          const gain = q("[data-out-gain]", rows[i]);
          gain.hidden = v.gain == null;
          if (v.gain != null) {
            gain.className = `inline-flex items-center rounded-full px-2.5 py-0.5 text-[12px] font-semibold ring-1 ${badges[direction(v.gain, 0.5)]}`;
            gain.textContent = gainText(v.gain, v.cost!);
          }
          q("[data-out-note]", rows[i]).textContent = v.note;
        });
      }
      root.dataset.state = JSON.stringify(store);
      root.dispatchEvent(new CustomEvent("flowchange", { bubbles: true }));
      return store;
    };

    const save = () => {
      const store = recalc();
      try {
        localStorage.setItem(KEY, JSON.stringify(store));
      } catch {}
    };

    // Stored v4 wins. Older stores (v3, v2) held hand-typed holdings priced from Yahoo, which the
    // GBM import replaces; their fixed income and PPRs carry over onto the seed portfolio.
    const valid = (s: any) => s && MANUAL.every((b) => Array.isArray(s[b]));
    let store = seed;
    try {
      const stored = JSON.parse(localStorage.getItem(KEY) ?? "null");
      if (valid(stored) && "portfolio" in stored) store = stored;
      else
        for (const key of JSON.parse(root.dataset.oldKeys!) as string[]) {
          const old = JSON.parse(localStorage.getItem(key) ?? "null");
          if (valid(old)) {
            store = { portfolio: seed.portfolio, fixedIncome: old.fixedIncome, ppr: old.ppr };
            break;
          }
        }
    } catch {}
    fill(store);
    recalc();

    const importInput = q<HTMLInputElement>("[data-import]");
    importInput.addEventListener("change", async () => {
      const file = importInput.files?.[0];
      importInput.value = "";
      if (!file) return;
      const error = q("[data-import-error]");
      try {
        portfolio = parseGbmCsv(await file.text(), file.name);
        error.hidden = true;
        save();
      } catch (e) {
        error.textContent = e instanceof Error ? e.message : `Couldn't read ${file.name}.`;
        error.hidden = false;
      }
    });

    root.addEventListener("input", (e) => {
      if ((e.target as Element).closest("[data-row]")) save();
    });
    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("button");
      if (!btn) return;
      if (btn.matches("[data-add]")) {
        q<HTMLInputElement>("[data-f]", addRow(btn.dataset.add as ManualBucketId)).focus();
      } else if (btn.matches("[data-remove]")) {
        btn.closest("[data-row]")!.remove();
      } else if (btn.matches("[data-reset]")) {
        if (!confirmReset()) return;
        fill(seed);
        q("[data-import-error]").hidden = true;
        try {
          localStorage.removeItem(KEY);
          (JSON.parse(root.dataset.oldKeys!) as string[]).forEach((k) => localStorage.removeItem(k));
        } catch {}
        recalc();
        return;
      } else return;
      save();
    });
  };

  document.querySelectorAll<HTMLElement>("[data-investment-editor]").forEach(init);
</script>
