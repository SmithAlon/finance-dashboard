---
import type { Account } from '../data/types';
import { mxn } from '../lib/format';

interface Props {
  accounts: Account[];
}
const { accounts } = Astro.props;

const total = accounts.reduce((s, a) => s + a.amount, 0);
const colors = ['var(--inflow)', 'var(--brand)', 'var(--ink-3)', 'var(--passive)'];
---
<div class="card">
  <h2 class="text-xl mb-2">Balance sheet</h2>
  <div class="flex h-[18px] rounded-full overflow-hidden gap-0.5 mt-1 mb-3.5" role="img" aria-label="Asset allocation">
    {
      accounts.map((a, i) => (
        <i
          class="block h-full"
          style={`width:${(a.amount / total) * 100}%;background:${colors[i]}`}
          title={`${a.name}: ${mxn(a.amount)}`}
        />
      ))
    }
  </div>
  <table class="data-table">
    <thead>
      <tr><th>Account</th><th>Institution</th><th>Purpose</th><th class="text-right!">Balance</th></tr>
    </thead>
    <tbody>
      {
        accounts.map((a, i) => (
          <tr>
            <td><span class="dot" style={`background:${colors[i]}`} />{a.name}</td>
            <td>{a.institution}</td>
            <td>{a.purpose}</td>
            <td class="mono text-right">{mxn(a.amount)}</td>
          </tr>
        ))
      }
      <tr class="[&_td]:font-semibold [&_td]:border-b-0">
        <td colspan="3">Total in accounts, before credit owed</td>
        <td class="mono text-right">{mxn(total)}</td>
      </tr>
    </tbody>
  </table>
</div>
