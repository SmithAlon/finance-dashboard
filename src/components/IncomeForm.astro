---
import IncomeRow from './IncomeRow.astro';
import type { IncomeCategory, IncomeItem } from '../data/types';
import { mxn, pct } from '../lib/format';
import { tones } from '../lib/tone';

interface Props {
  categories: IncomeCategory[];
  /** Starting rows (monthly amounts); restored whenever the form is reset. */
  items: IncomeItem[];
}
const { categories, items } = Astro.props;

const seed = items.map((i) => ({ label: i.label, amount: i.amount, freq: 'month', category: i.category }));
const subtotal = (id: string) => items.filter((i) => i.category === id).reduce((a, i) => a + i.amount, 0);
const total = items.reduce((a, i) => a + i.amount, 0);
---
<div class="grid gap-4" data-income-form data-seed={JSON.stringify(seed)}>
  <div class="card">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 class="text-xl">Inflows</h2>
      <button data-reset type="button" class="text-[13px] text-ink-2 hover:text-ink underline underline-offset-2 cursor-pointer">
        Reset to saved profile
      </button>
    </div>
    <p class="sub mt-1 mb-0">
      Enter each source of income and choose its type. Amounts can be weekly, every two weeks, monthly or yearly; every
      line is converted to a monthly figure for the totals. Changes are saved in this browser.
    </p>
  </div>

  <section class="card" aria-labelledby="income-sources">
    <header class="flex items-center justify-between gap-3 mb-1.5">
      <h3 id="income-sources" class="text-base">Income sources</h3>
      <b class="mono text-lg" data-total-inline>{mxn(total)}</b>
    </header>
    <p class="sub mb-2">Pick a type for each line: {categories.map((c) => c.label.toLowerCase()).join(', ')}.</p>

    <div class="hidden md:grid grid-cols-[1fr_150px_110px_130px_96px_32px] gap-2 label pb-1 border-b border-line">
      <span>Source</span>
      <span>Type</span>
      <span class="text-right">Amount</span>
      <span>Frequency</span>
      <span class="text-right">Per month</span>
    </div>
    <ul data-rows>
      {items.map((i) => <IncomeRow label={i.label} amount={i.amount} category={i.category} categories={categories} />)}
    </ul>
    <p data-empty class="text-ink-2 text-[13px] py-2" hidden={items.length > 0}>No income here yet.</p>

    <button
      data-add
      type="button"
      class="mt-3 inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 -ml-2.5 text-[13px] font-medium text-brand hover:text-brand-hover hover:bg-brand/10 transition-colors cursor-pointer"
    >
      + Add income
    </button>
  </section>

  <section class="card border-inflow/30 ring-1 ring-inflow/20 bg-linear-to-br from-inflow/10 via-surface to-surface" aria-labelledby="income-total">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
      <div class="grid gap-0.5">
        <span id="income-total" class="label">Total monthly income</span>
        <b class="mono text-[34px]" data-total aria-live="polite">{mxn(total)}</b>
      </div>
      <span class="text-ink-2 text-[13px]">
        <b class="mono text-ink" data-annual>{mxn(total * 12)}</b> per year
      </span>
    </div>

    <div class="flex h-3 rounded-full overflow-hidden gap-0.5 mt-4 mb-3 bg-surface-2" role="img" aria-label="Income by category">
      {categories.map((c) => <i class:list={['block h-full', tones[c.tone].dot]} data-bar={c.id} style={`width:${total ? (subtotal(c.id) / total) * 100 : 0}%`} />)}
    </div>
    <ul class="grid gap-1.5 text-[13px]">
      {
        categories.map((c) => (
          <li class="grid grid-cols-[1fr_auto_56px] gap-3 items-center">
            <span class="flex items-center"><span class:list={['dot', tones[c.tone].dot]} />{c.label}</span>
            <b class="mono" data-cat-total={c.id}>{mxn(subtotal(c.id))}</b>
            <span class="mono text-ink-2 text-right" data-cat-share={c.id}>{pct(total ? subtotal(c.id) / total : 0)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <template data-row-template><IncomeRow categories={categories} /></template>
</div>

<script>
  import { toMonthly } from '../lib/income';
  import { mxn, pct } from '../lib/format';
  import type { Frequency } from '../data/types';

  type Row = { label: string; amount: number | null; freq: Frequency; category: string };

  const KEY = 'finance:inflows:v2';
  const OLD_KEY = 'finance:inflows:v1';
  const root = document.querySelector<HTMLElement>('[data-income-form]');

  if (root) {
    const tpl = root.querySelector<HTMLTemplateElement>('[data-row-template]')!;
    const list = root.querySelector<HTMLElement>('[data-rows]')!;
    const seed: Row[] = JSON.parse(root.dataset.seed!);
    const q = <T extends Element = HTMLElement>(el: ParentNode, sel: string) => el.querySelector<T>(sel)!;
    const catIds = [...root.querySelectorAll<HTMLElement>('[data-bar]')].map((b) => b.dataset.bar!);

    const readRow = (row: HTMLElement): Row => {
      const raw = q<HTMLInputElement>(row, '[data-amount]').value;
      return {
        label: q<HTMLInputElement>(row, '[data-label]').value,
        amount: raw === '' ? null : Math.max(0, Number(raw) || 0),
        freq: q<HTMLSelectElement>(row, '[data-freq]').value as Frequency,
        category: q<HTMLSelectElement>(row, '[data-category]').value,
      };
    };

    const addRow = (r?: Row) => {
      const row = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      if (r) {
        q<HTMLInputElement>(row, '[data-label]').value = r.label;
        q<HTMLInputElement>(row, '[data-amount]').value = r.amount == null ? '' : String(r.amount);
        q<HTMLSelectElement>(row, '[data-freq]').value = r.freq;
        if (catIds.includes(r.category)) q<HTMLSelectElement>(row, '[data-category]').value = r.category;
      }
      list.append(row);
      return row;
    };

    const fill = (rows: Row[]) => {
      list.replaceChildren();
      rows.forEach((r) => addRow(r));
    };

    const recalc = () => {
      const totals: Record<string, number> = Object.fromEntries(catIds.map((id) => [id, 0]));
      const rows = [...list.querySelectorAll<HTMLElement>('[data-row]')];
      const state = rows.map((row) => {
        const r = readRow(row);
        const monthly = toMonthly(r.amount ?? 0, r.freq);
        q(row, '[data-monthly]').textContent = mxn(monthly);
        totals[r.category] = (totals[r.category] ?? 0) + monthly;
        return r;
      });
      const total = Object.values(totals).reduce((a, b) => a + b, 0);
      q(root, '[data-empty]').hidden = rows.length > 0;
      q(root, '[data-total-inline]').textContent = mxn(total);
      q(root, '[data-total]').textContent = mxn(total);
      q(root, '[data-annual]').textContent = mxn(total * 12);
      for (const [id, sub] of Object.entries(totals)) {
        const share = total ? sub / total : 0;
        q(root, `[data-bar="${id}"]`).style.width = share * 100 + '%';
        q(root, `[data-cat-total="${id}"]`).textContent = mxn(sub);
        q(root, `[data-cat-share="${id}"]`).textContent = pct(share);
      }
      return state;
    };

    const save = () => {
      const state = recalc();
      try {
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch {}
    };

    try {
      const stored = JSON.parse(localStorage.getItem(KEY) ?? 'null');
      if (Array.isArray(stored)) fill(stored);
      else {
        // v1 stored rows grouped by category id; flatten them.
        const old = JSON.parse(localStorage.getItem(OLD_KEY) ?? 'null');
        if (old && typeof old === 'object')
          fill(Object.entries(old).flatMap(([category, rows]) => (rows as Row[]).map((r) => ({ ...r, category }))));
      }
    } catch {}
    recalc();

    root.addEventListener('input', save);
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      if (btn.matches('[data-add]')) {
        q<HTMLInputElement>(addRow(), '[data-label]').focus();
      } else if (btn.matches('[data-remove]')) {
        btn.closest('[data-row]')!.remove();
      } else if (btn.matches('[data-reset]')) {
        fill(seed);
        try {
          localStorage.removeItem(KEY);
          localStorage.removeItem(OLD_KEY);
        } catch {}
        recalc();
        return;
      } else return;
      save();
    });
  }
</script>
